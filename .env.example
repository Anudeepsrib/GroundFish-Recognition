# =============================================================================
# GroundFish-Recognition Environment Variables
# Copy to .env and fill in your values. NEVER commit .env
#
#   cp .env.example .env
#
# These are ONLY required when you actually download datasets or run real
# training. Dry-run mode (`--dry-run`) never touches Roboflow or GPUs.
# =============================================================================

# --- Roboflow Credentials (REQUIRED for real dataset downloads) ---
# Get your key from https://app.roboflow.com/settings/api
# Rotate immediately if you ever accidentally commit it.
ROBOFLOW_API_KEY=your_roboflow_api_key_here

# Workspace and Project identifiers (from your Roboflow URLs)
# Example workspace: "pratishthit-choudhary" or "project-5fr4i"
ROBOFLOW_WORKSPACE_CONVEYOR=your_workspace_for_conveyor
ROBOFLOW_PROJECT_CONVEYOR=fish-conveyor-segmentation
ROBOFLOW_VERSION_CONVEYOR=7

ROBOFLOW_WORKSPACE_UNDERWATER=your_workspace_for_underwater
ROBOFLOW_PROJECT_UNDERWATER=underwater-fish-detection
ROBOFLOW_VERSION_UNDERWATER=3

# --- Optional: Experiment output root (defaults to ./runs) ---
# EXPERIMENT_OUTPUT_DIR=runs

# --- Optional: Ultralytics settings ---
# ULTRALYTICS_VERBOSE=true
# WANDB_DISABLED=true   # set to true to disable wandb even if installed

# --- Hardware hint (scripts respect this but CLI --device overrides) ---
# CUDA_VISIBLE_DEVICES=0

# Note: The original notebooks used two different workspaces and inconsistent
# versions. Fill with the versions you actually want to reproduce.
# If your datasets are private, you must have access rights.